# Local development — copy to .env.local
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
POPPLER_PATH=C:\tools\poppler\Library\bin
SHARD_BASE_PATH=./data

# Logging (see app/logging_config.py + README's "comparing two machines via
# logs" section). "json" renders every logger.*(..., extra={...}) field
# inline as one parseable object per line — set LOG_LEVEL=DEBUG to also see
# the per-redaction padding clamp decision from app/services/pii/coordinate_map.py.
LOG_LEVEL=INFO
LOG_FORMAT=json

# Redact pipeline
REDACT_PIPELINE_ENABLED=true
BLUR_THRESHOLD_GOOD=100
BLUR_THRESHOLD_MILD=50
PADDING_PX_GOOD=4
PADDING_PX_MILD=8
PADDING_PX_SEVERE=12
ENSEMBLE_IOU_THRESHOLD=0.5
# Output pages are rasterized (at REDACT_DPI) with redaction boxes burned in,
# then re-encoded into the final PDF — see app/services/redact/pdf_renderer.py.
# "jpeg" (default) keeps output size close to the original; "png" is
# lossless but often 5-10x larger for a scanned/photographed page, with no
# visible quality gain once the redaction boxes are already painted on.
REDACT_OUTPUT_IMAGE_FORMAT=jpeg
REDACT_OUTPUT_JPEG_QUALITY=85
# Deterministic OCR policy: exactly one engine runs per page by default,
# chosen from this order — never a cross-engine vote (see
# app/services/ocr/ensemble.py). "multi" restores the legacy parallel vote
# for debugging/engine comparison only.
OCR_PRIMARY_ENGINE=rapidocr
OCR_FALLBACK_ENGINES=tesseract,easyocr
OCR_ENSEMBLE_MODE=single
# Startup engine-availability check (app/services/ocr/environment_check.py).
# Only the primary engine is required by default -- tesseract/easyocr are a
# fallback, not part of the default deterministic path. Widen this (e.g.
# "rapidocr,tesseract") for a deployment that wants the fallback guaranteed too.
# Set OCR_STRICT_ENGINE_CHECK=true in CI/production so a machine silently
# missing a required engine fails fast instead of serving degraded output.
OCR_REQUIRED_ENGINES=rapidocr
OCR_STRICT_ENGINE_CHECK=false
# Legacy multi-engine mode only: when a word-cluster tie falls inside a
# Docling-detected table/cell region, prefer this engine's reading instead
# of the default highest-confidence tie-break (RapidOCR tends to read table
# layouts more reliably).
OCR_TABLE_BIAS_ENABLED=true
OCR_TABLE_BIAS_ENGINE=rapidocr
OCR_TABLE_BIAS_MIN_OVERLAP=0.5
# Fail-safe: absorb an unmatched name-shaped word sitting immediately next
# to an already-redacted span into that redaction, instead of leaving it
# exposed as bare text (see app/pipeline/redact.py's
# _apply_spillover_safety_net). Never mints a new redaction/dictionary entry.
SPILLOVER_SAFETY_NET_ENABLED=true
# Words the spillover net never absorbs even though they look name-shaped
# (capitalized, alphabetic) — common document/tax abbreviations (e.g. a
# "DPP"/"PPN" tax-base line beside a redacted fund name) that are never
# themselves part of the adjacent PII, unlike a real fund-name continuation
# word (e.g. "Plus").
SPILLOVER_NON_NAME_STOPWORDS=DPP,PPN,NPWP,VAT,GST,REF,NO,ATTN,ATTENTION,CC,FAX,TELP,PHONE,EMAIL,PAGE,ENC,ENCL
MAX_CONCURRENT_PAGES=2
DOCLING_ENABLED=true
# img2table (OpenCV border/line detection, no ML weights) supplements
# Docling's TableFormer for table/cell geometry — deterministic by
# construction since it reads actual gridlines, not a learned prediction
# (see app/services/structure/table_geometry.py). Its cells replace
# Docling's own wherever it corroborates a Docling table region; Docling
# stays the fallback everywhere else, so coverage never regresses.
IMG2TABLE_ENABLED=true
IMG2TABLE_MIN_TABLE_IOU=0.3
MAX_PAGES_PER_DOCUMENT=50
ADMIN_AUTH_ENABLED=false
API_KEY=

# Mock dictionary + brand zones
MOCK_DICTIONARY_PATH=./data/mock-dictionary/mappings.json
FOOTER_ZONE_BOTTOM_PCT=0.12
# Generic image/graphic redaction — covers any Docling-detected picture
# block anywhere on the page (including a logo, wherever it sits), not
# just a fixed top-right rectangle tuned for one template.
PATCH_IMAGES_ENABLED=true
IMAGE_ZONE_MIN_AREA_PCT=0.0015

# Field-anchored PII detection (replaces whole-page Presidio/spaCy NER)
FIELD_DETECTION_ENABLED=true
# Also scan each page's full OCR text directly for every value already
# curated in the mock dictionary, independent of field_detection_enabled's
# layout/label matching — catches a known name/org anywhere it appears on
# the page. See app/config.py's dictionary_scan_enabled docstring.
DICTIONARY_SCAN_ENABLED=true
# Restrict detection to values already present in the mock dictionary — no
# brand-new auto-created entries for text nothing matches. Curate the
# dictionary (UI override or CSV import) to teach it new values; set to
# false to go back to fully free-running auto-detection.
RESTRICT_TO_KNOWN_MAPPINGS=true
FUZZY_MATCH_THRESHOLD=0.85
STRIP_GRIDLINES_ENABLED=true
# Corrects small page rotation (crooked scans/off-angle phone photos)
# before any other preprocessing (app/services/preprocess/deskew.py) —
# deterministic (OpenCV minAreaRect), no ML weights.
DESKEW_ENABLED=true
# Curated, git-tracked seed of known name/account-number -> mock rows,
# loaded once at startup without clobbering existing mappings — e.g.
# {"entries": [{"source_text": "Standard Chartered Custody", "mock_value": "ORG_SEED_01"}]}.
# MOCK_DICTIONARY_PATH above is the separate, git-ignored, machine-local
# runtime cache (hit_count/timestamps/auto-learned entries); cloning the
# repo always starts from this seed's identical curated mappings. Unset to
# disable seeding entirely.
MOCK_SEED_PATH=./data/mock-dictionary/mappings.seed.json

# Native-text bypass: a digital/copyable-text PDF page reads its text
# directly from the PDF instead of re-OCRing a rasterized image of it (see
# app/services/ocr/native_text.py), and is redacted with the vector-native
# path (real PyMuPDF redaction annotations) instead of the raster
# paint-then-flatten path. Set to false to force every page through the
# scanned/OCR path unconditionally — no page is ever classified "digital",
# regardless of how much real text layer it carries.
NATIVE_TEXT_BYPASS_ENABLED=true
NATIVE_TEXT_MIN_WORDS=20
NATIVE_TEXT_MIN_COVERAGE_PCT=0.02

# Folder-watch ingestion (extension, alongside the UI/API upload) — polls
# WATCH_INPUT_DIR for new files and redacts them one at a time (never in
# parallel), dropping each result into WATCH_OUTPUT_DIR. A file that errors
# is left untouched in WATCH_INPUT_DIR and retried on the next scan; see
# app/services/watch/folder_watcher.py. Disabled by default.
WATCH_ENABLED=true
WATCH_INPUT_DIR=./data/watch/input
WATCH_OUTPUT_DIR=./data/watch/output
WATCH_POLL_SECONDS=5
