# Local runtime-learned mock-dictionary cache (hit_count/timestamps/auto
# entries) — machine-local scratch state, not source of truth. The curated,
# git-tracked seed lives in mappings.seed.json and is explicitly re-included
# below so cloning the repo always starts from identical curated mappings.
data/mock-dictionary/*
!data/mock-dictionary/mappings.seed.json
*.egg-info/
.pytest_cache/
.fsd3/
.mypy_cache/
.ruff_cache/
# Folder-watch ingestion scratch dirs (machine-local input/output for
# app/services/watch/folder_watcher.py) — not source of truth.
data/watch/